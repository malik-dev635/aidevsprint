{
  "kind": "collectionType",
  "collectionName": "inscriptions",
  "info": {
    "singularName": "inscription",
    "pluralName": "inscriptions",
    "displayName": "Inscription",
    "description": "Une demande de place. Champs tirés de CLAUDE.md : « nom, contact, paiement »."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nom": {
      "type": "string",
      "required": true
    },
    "telephone": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email"
    },
    "statut": {
      "type": "enumeration",
      "enum": ["en_attente", "payee", "annulee"],
      "default": "en_attente",
      "required": true
    },
    "montantFCFA": {
      "type": "integer",
      "min": 0
    },
    "referencePaiement": {
      "type": "string",
      "private": true
    },
    "edition": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::edition.edition",
      "inversedBy": "inscriptions"
    }
  }
}
