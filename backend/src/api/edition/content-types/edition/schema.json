{
  "kind": "collectionType",
  "collectionName": "editions",
  "info": {
    "singularName": "edition",
    "pluralName": "editions",
    "displayName": "Édition",
    "description": "Une session de la formation. Transcription du type Edition du front (src/lib/edition.ts)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "numero": {
      "type": "integer",
      "required": true,
      "unique": true,
      "min": 1
    },
    "dateDebut": {
      "type": "datetime"
    },
    "ville": {
      "type": "string",
      "required": true,
      "default": "Yamoussoukro"
    },
    "lieu": {
      "type": "string"
    },
    "prixFCFA": {
      "type": "integer",
      "min": 0
    },
    "quota": {
      "type": "integer",
      "min": 1
    },
    "inscrits": {
      "type": "integer",
      "min": 0
    },
    "format": {
      "type": "string",
      "required": true,
      "default": "1 journée · présentiel"
    },
    "inscriptions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::inscription.inscription",
      "mappedBy": "edition"
    },
    "formateurs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::formateur.formateur",
      "inversedBy": "editions"
    }
  }
}
