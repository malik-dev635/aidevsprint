# Adresse du back Laravel, sans barre oblique finale.
#
# Le formulaire d'inscription poste sur ${NEXT_PUBLIC_API_URL}/api/inscriptions.
# `NEXT_PUBLIC_` : la variable est lue dans le navigateur, elle est donc
# publique — n'y mets jamais autre chose qu'une URL.
#
# Sans cette variable, le formulaire ne tente aucun envoi et affiche le
# numéro WhatsApp à la place. C'est voulu : un repli silencieux sur
# localhost partirait en production et perdrait les inscriptions.
#
# En local : php artisan serve --port=8001 depuis backend/
NEXT_PUBLIC_API_URL=http://localhost:8001
